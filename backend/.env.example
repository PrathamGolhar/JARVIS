# =============================================================================
# JARVIS 2.0 — Backend Canonical Environment Configuration Template
# =============================================================================

# Server & Network Configuration
JARVIS_ENV=development
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
JARVIS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:1420,http://127.0.0.1:5173,http://127.0.0.1:1420

# AI Provider Configuration (Options: auto, gemini, groq, openai, anthropic, local)
JARVIS_AI_PROVIDER=auto

# Primary Multimodal & Vision AI (Google Gemini)
JARVIS_GEMINI_API_KEY=
JARVIS_GEMINI_MODEL=gemini-2.5-flash

# Ultra-Low Latency Conversational AI (Groq)
JARVIS_GROQ_API_KEY=
JARVIS_GROQ_MODEL=openai/gpt-oss-120b
JARVIS_GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# OpenAI Model Integration (Optional)
JARVIS_OPENAI_API_KEY=
JARVIS_OPENAI_MODEL=gpt-4o

# Anthropic Claude Integration (Optional)
JARVIS_ANTHROPIC_API_KEY=
JARVIS_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Neural Voice Synthesis & STT
JARVIS_ELEVENLABS_API_KEY=
JARVIS_STT_PROVIDER=groq-whisper
JARVIS_TTS_PROVIDER=edge-tts
EDGE_TTS_VOICE=en-US-GuyNeural

# Database Configuration (SQLite default)
JARVIS_DATABASE_URL=sqlite:///./data/jarvis_memory.db

# Workspace & Directory Boundaries
JARVIS_WORKSPACE_ROOT=../
JARVIS_UPLOAD_ROOT=./data/uploads
JARVIS_GENERATED_ROOT=./data/generated

# Security, Permissions & Sandbox
JARVIS_PERMISSION_MODE=assisted
JARVIS_LOCAL_ACTIONS_ENABLED=true
JARVIS_WEB_SEARCH_ENABLED=true
JARVIS_SANDBOX_TIMEOUT=15
JARVIS_SANDBOX_MEMORY_LIMIT=512
JARVIS_SANDBOX_CPU_LIMIT=80

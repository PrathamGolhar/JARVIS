# =============================================================================
# JARVIS 2.0 — Backend Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it is listed in .gitignore.
#
# Quick start:
#   cp .env.example .env
#   # Then edit .env with your actual API keys
# =============================================================================

# -----------------------------------------------------------------------------
# AI PROVIDERS — Configure at least one.
# Auto-detection order: Gemini -> Groq -> OpenAI -> Local fallback
# -----------------------------------------------------------------------------

# Google Gemini (Recommended: best reasoning, fastest)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq (Fast inference, free tier available)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# OpenAI (GPT-4o etc.)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# TEXT-TO-SPEECH (Optional)
# -----------------------------------------------------------------------------

# ElevenLabs neural voice synthesis (requires subscription)
# Get yours at: https://elevenlabs.io/app/speech-synthesis
ELEVENLABS_API_KEY=

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------

JARVIS_BACKEND_HOST=127.0.0.1
JARVIS_BACKEND_PORT=8765

# Comma-separated allowed origins for CORS.
# Add your frontend's actual URL. NEVER use wildcard (*) in production.
JARVIS_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# LOCAL ACTIONS BRIDGE (Windows only)
# Set to true to allow JARVIS to launch applications and manage files locally.
# Only enable on trusted machines.
# -----------------------------------------------------------------------------
JARVIS_LOCAL_ACTIONS_ENABLED=false

# Permission mode: read_only | assisted (recommended) | full_control
JARVIS_PERMISSION_MODE=assisted

# AI provider preference: auto | gemini | groq | openai | local
JARVIS_AI_PROVIDER=auto

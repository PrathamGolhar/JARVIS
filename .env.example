# ==============================================================================
# JARVIS — Environment Configuration Template
# Copy this file to .env and insert your respective API keys.
# ==============================================================================

# Server & Network Configuration
PORT=8765
HOST=127.0.0.1
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:1420,http://127.0.0.1:5173,http://127.0.0.1:1420

# AI Provider Configuration (Select: auto, gemini, groq, openai, local)
AI_PROVIDER=auto

# Primary Multimodal & Vision AI (Recommended)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ultra-Low Latency Conversational AI (Optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Model Integration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude Integration (Optional)
ANTHROPIC_API_KEY=

# Neural Voice Synthesis (ElevenLabs / Edge-TTS)
ELEVENLABS_API_KEY=
EDGE_TTS_VOICE=en-US-ChristopherNeural

# Database Configuration (SQLite default for local, PostgreSQL for prod)
DATABASE_URL=sqlite:///./data/jarvis.db

# Security & Execution Sandbox
JARVIS_SAFETY_TIER=ASSISTED
JARVIS_SANDBOX_TIMEOUT=15
JARVIS_WORKSPACE_DIR=./data/workspace
